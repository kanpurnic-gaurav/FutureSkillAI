    "import cv2\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from PIL import Image"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "38345b86-98a7-4617-97ae-1d82c8855534",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
