   ],
   "source": [
    "plt.figure(figsize=(12, 5))\n",
    "\n",
    "plt.subplot(1, 2, 1)\n",
    "plt.imshow(img1)\n",
    "plt.title(\"cm\")\n",
    "plt.axis(\"off\")\n",
    "\n",
    "plt.subplot(1, 2, 2)\n",
    "plt.imshow(img2)\n",
    "plt.title(\"dm\")\n",
    "plt.axis(\"off\")\n",
    "\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "a48fae5d-e4db-4a61-a369-ecf19f4024f3",
   "metadata": {},
   "outputs": [],
   "source": [
    "width = 1280\n",
    "height = 720\n",
    "\n",
    "img1 = img1.resize((width, height))\n",
    "img2 = img2.resize((width, height))\n",
    "\n",
    "img1_np = np.array(img1)\n",
    "img2_np = np.array(img2)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "b6ad8b58-b26e-44f1-8430-dabd622963a7",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x500 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "blended = cv2.addWeighted(\n",
    "    img1_np, 0.6,\n",
    "    img2_np, 0.4,\n",
    "    0\n",
    ")\n",
    "\n",
    "plt.figure(figsize=(10, 5))\n",
    "plt.imshow(blended)\n",
    "plt.title(\"60% cm + 40% dm\")\n",
    "plt.axis(\"off\")\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "246571d7-dd70-48bc-a653-9aab0befa84a",
   "metadata": {},
