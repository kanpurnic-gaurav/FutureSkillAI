     "output_type": "stream",
     "text": [
      "Blended image saved successfully!\n"
     ]
    }
   ],
   "source": [
    "cv2.imwrite(\n",
    "    \"blended_image.jpg\",\n",
    "    cv2.cvtColor(blended, cv2.COLOR_RGB2BGR)\n",
    ")\n",
    "\n",
    "print(\"Blended image saved successfully!\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "69ca7229-a1fe-4907-bfd1-a797e48e3acc",
   "metadata": {},
   "outputs": [],
   "source": [
    "def zoom_image(image, zoom_factor):\n",
    "    h, w = image.shape[:2]\n",
    "\n",
    "    new_h = int(h / zoom_factor)\n",
    "    new_w = int(w / zoom_factor)\n",
    "\n",
    "    y1 = (h - new_h) // 2\n",
    "    x1 = (w - new_w) // 2\n",
    "\n",
    "    cropped = image[y1:y1 + new_h, x1:x1 + new_w]\n",
    "\n",
    "    zoomed = cv2.resize(cropped, (w, h))\n",
    "\n",
    "    return zoomed"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "4e1135dd-570a-49a4-8853-f6f7c3eeca99",
   "metadata": {},
   "outputs": [],
   "source": [
    "def cross_dissolve(image1, image2, alpha):\n",
    "    return cv2.addWeighted(\n",
    "        image1, 1 - alpha,\n",
    "        image2, alpha,\n",
    "        0\n",
    "    )"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "1679a988-ceae-406f-9dde-e1daf9d32bc5",
   "metadata": {},
   "outputs": [],
   "source": [
    "fps = 30\n",
    "duration = 3\n",
    "total_frames = fps * duration\n",
    "\n",
    "video_path = \"image_blending_video.mp4\"\n",
    "\n",
    "fourcc = cv2.VideoWriter_fourcc(*\"mp4v\")\n",
    "\n",
    "out = cv2.VideoWriter(\n",
    "    video_path,\n",
    "    fourcc,\n",
    "    fps,\n",
    "    (width, height)\n",
    ")\n",
    "\n",
    "transition_frames = 6  # 0.2 seconds"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "8d78523c-02a4-4e2e-8935-fcc1b6399b68",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Video created successfully: image_blending_video.mp4\n"
     ]
    }
   ],
   "source": [
    "for frame_num in range(total_frames):\n",
    "\n",
    "    t = frame_num / fps\n",
    "\n",
    "    # Scene 1: cm (0–1 second)\n",
    "    if t < 1.0 - transition_frames / fps:\n",
    "\n",
    "        progress = t / 1.0\n",
    "\n",
    "        zoom_factor = 1.0 + 0.04 * progress\n",
    "\n",
    "        frame = zoom_image(img1_np, zoom_factor)\n",
    "\n",
    "    # Transition 1: cm to dm\n",
    "    elif t < 1.0:\n",
    "\n",
    "        alpha = (t - (1.0 - transition_frames / fps)) / (transition_frames / fps)\n",
    "\n",
    "        frame = cross_dissolve(img1_np, img2_np, alpha)\n",
    "\n",
    "    # Scene 2: dm (1–2 seconds)\n",
    "    elif t < 2.0 - transition_frames / fps:\n",
    "\n",
    "        progress = t - 1.0\n",
    "\n",
    "        zoom_factor = 1.0 + 0.03 * progress\n",
    "\n",
    "        frame = zoom_image(img2_np, zoom_factor)\n",
    "\n",
    "    # Transition 2: dm to cm\n",
    "    elif t < 2.0:\n",
    "\n",
    "        alpha = (t - (2.0 - transition_frames / fps)) / (transition_frames / fps)\n",
    "\n",
    "        frame = cross_dissolve(img2_np, blended, alpha)\n",
    "\n",
    "    # Scene 3: Final blended image (2–3 seconds)\n",
    "    else:\n",
    "\n",
    "        frame = blended.copy()\n",
    "\n",
    "    # Convert RGB to BGR for OpenCV\n",
    "    frame_bgr = cv2.cvtColor(frame, cv2.COLOR_RGB2BGR)\n",
    "\n",
    "    out.write(frame_bgr)\n",
    "\n",
    "out.release()\n",
    "\n",
    "print(\"Video created successfully:\", video_path)"
   ]
  },
