      "image 2 size: (4000, 4000)\n"
     ]
    }
   ],
   "source": [
    "img1 = Image.open(\"image1.jpg\").convert(\"RGB\")\n",
    "img2 = Image.open(\"image2.jpg\").convert(\"RGB\")\n",
    "\n",
    "print(\"image 1 size:\", img1.size)\n",
    "print(\"image 2 size:\", img2.size)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "65a780d6-359d-4957-bf11-51f8d731d0b3",
   "metadata": {},
   "outputs": [
    {
     "data": {
